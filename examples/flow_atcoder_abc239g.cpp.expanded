using namespace std;

#include <iostream>
#include <vector>

template <class T>
std::istream& operator>>(std::istream& is, std::vector<T>& a) {
    for (auto& x : a) {
        is >> x;
    }
    return is;
}

template <class T>
std::ostream& operator<<(std::ostream& os, const std::vector<T>& a) {
    bool is_first = true;
    for (const auto& x : a) {
        if (is_first) {
            is_first = false;
        } else {
            os << ' ';
        }
        os << x;
    }
    return os << std::endl;
}

#include <compare>
#include <cstdint>
#include <deque>
#include <functional>

struct UsedCounter {
    explicit UsedCounter(int n = 0): used(n) {}

    void Assign(int n) {
        used.assign(n, 0);
        t = 1;
    }

    bool operator[](int i) const {
        return used[i] >= t;
    }

    int Get(int i) const {
        return used[i];
    }

    void Set(int i, int val) {
        used[i] = val;
    }

    void Use(int i) {
        used[i] = t;
    }

    void Reset() {
        ++t;
    }

    std::vector<int> used;
    int t = 1;
};

using Cap = int64_t;
const Cap kMax = 4e18;

struct Flow {
    struct Vertex {
        friend struct Flow;

        Vertex() = default;
        bool operator==(const Vertex&) const = default;
        std::strong_ordering operator<=>(const Vertex&) const = default;

    private:
        explicit Vertex(int v): v(v) {}

        int v = -1;
    };

    struct Edge {
        friend struct Flow;

        Edge() = default;
        bool operator==(const Edge&) const = default;
        std::strong_ordering operator<=>(const Edge&) const = default;

    private:
        explicit Edge(int e): e(e) {}

        int e = -1;
    };

    struct FlowUsedCounter : private UsedCounter {
        using UsedCounter::UsedCounter;
        using UsedCounter::Assign;
        using UsedCounter::Reset;

        bool operator[](Vertex v) const {
            return UsedCounter::operator[](v.v);
        }

        int Get(Vertex v) const {
            return UsedCounter::Get(v.v);
        }

        void Set(Vertex v, int x) {
            return UsedCounter::Set(v.v, x);
        }

        void Use(Vertex v) {
            return UsedCounter::Use(v.v);
        }
    };

    struct EdgeData {
        Vertex to;
        Cap cap;
    };

    struct Graph : private std::vector<std::vector<Edge>> {
        using vector::vector;

        Graph(const vector& g): vector(g) {}

        Edge Last(Vertex v) const {
            return (*this)[v.v].back();
        }

        void Pop(Vertex v) {
            (*this)[v.v].pop_back();
        }

        void Add(Vertex v, Edge e) {
            (*this)[v.v].push_back(e);
        }

        bool HasEdges(Vertex v) const {
            return !(*this)[v.v].empty();
        }
    };

    const Vertex S{0};
    const Vertex T{1};

    explicit Flow(int approx_vertices = 0, int approx_edges = 0) {
        g.reserve(approx_vertices);
        edges.reserve(approx_edges * 2);
        g.resize(2);
    }

    Vertex AddVertex() {
        Vertex ans{Vertices()};
        g.emplace_back();
        return ans;
    }

    EdgeData& At(Edge e) {
        return edges[e.e];
    }

    const EdgeData& At(Edge e) const {
        return edges[e.e];
    }

    Edge AddEdge(Vertex from, Vertex to, Cap cap) {
        Edge to_e{Edges()};
        edges.emplace_back(to, cap);
        edges.emplace_back(from, 0);
        g[from.v].push_back(to_e);
        g[to.v].push_back(Backward(to_e));
        return to_e;
    }

    Cap CanPush(Edge edge) const {
        return At(edge).cap;
    }

    Cap Flowing(Edge edge) const {
        return At(Backward(edge)).cap;
    }

    Cap Capacity(Edge edge) const {
        return CanPush(edge) + Flowing(edge);
    }

    Vertex To(Edge edge) const {
        return At(edge).to;
    }

    void AddFlow(Edge edge, Cap cnt) {
        At(edge).cap -= cnt;
        At(Backward(edge)).cap += cnt;
    }

    Cap MaxCapacity() const {
        Cap mx = 0;
        for (int i = 0; i < Edges(); i += 2) {
            mx = std::max(mx, Capacity(Edge{i}));
        }
        return mx;
    }

    Cap Ford(Cap at_least = 1) {
        Graph gr(g);
        return Ford(at_least, gr);
    }

    Cap ScalableFord() {
        return Scalable(&Flow::Ford);
    }

    Cap Dinic(Cap at_least = 1) {
        Cap ans = 0;
        bool fail = false;
        Graph gr = DinicBFS(at_least, fail);
        while (!fail) {
            Cap x = Ford(at_least, gr);
            if (x == 0) {
                break;
            }
            ans += x;
            gr = DinicBFS(at_least, fail);
        }
        return ans;
    }

    Cap ScalableDinic() {
        return Scalable(&Flow::Dinic);
    }

    Cap PushRelabel() {
        std::vector<int> nxt_(Vertices());
        std::vector<int> h_(Vertices());
        std::vector<Cap> extra_(Vertices());

        auto h = [&](Vertex v) -> int& {
            return h_[v.v];
        };

        auto nxt = [&](Vertex v) -> int& {
            return nxt_[v.v];
        };

        auto extra = [&](Vertex v) -> Cap& {
            return extra_[v.v];
        };

        auto push = [&](Vertex v, Edge e) {
            Cap val = std::min(extra(v), CanPush(e));
            AddFlow(e, val);
            extra(v) -= val;
            extra(To(e)) += val;
        };

        auto relabel = [&](Vertex v) {
            int mn = Vertices() + 10;
            for (auto i : Edges(v)) {
                if (CanPush(i) > 0) {
                    mn = min(mn, h(To(i)));
                }
            }
            h(v) = mn + 1;
        };

        auto discharge = [&](Vertex v) {
            while (extra(v) > 0) {
                Edge i = Edges(v)[nxt(v)];
                if (CanPush(i) > 0 && h(To(i)) < h(v)) {
                    push(v, i);
                }
                if (extra(v)) {
                    ++nxt(v);
                    if (nxt(v) == Edges(v).size()) {
                        nxt(v) = 0;
                        relabel(v);
                    }
                }
            }
        };

        for (auto i : Edges(S)) {
            Cap c = CanPush(i);
            AddFlow(i, c);
            extra(To(i)) += c;
        }

        for (int f = 1; f;) {
            f = 0;
            for (int i = 0; i < Vertices(); ++i) {
                Vertex v{i};
                if (extra(v) && v != T && v != S) {
                    f = 1;
                    discharge(v);
                }
            }
        }

        return extra(T);
    }

    int Vertices() const {
        return g.size();
    }

    int Edges() const {
        return edges.size();
    }

    std::vector<Edge> Cut() {
        used.Assign(Vertices());
        std::vector<Edge> ans;
        FrontCutDFS(S);
        for (int i = 0; i < Edges(); i += 2) {
            Edge e{i};
            if (!used[To(e)] && used[To(Backward(e))]) {
                ans.push_back(e);
            }
        }
        return ans;
    }

    std::vector<Edge>& Edges(Vertex v) {
        return g[v.v];
    }

private:
    void FrontCutDFS(Vertex v) {
        used.Use(v);
        for (auto u : Edges(v)) {
            if (!used[To(u)] && CanPush(u) > 0) {
                FrontCutDFS(To(u));
            }
        }
    }

    Cap Scalable(Cap (Flow::*fn)(Cap)) {
        Cap x = MaxCapacity();
        Cap ans = 0;
        while (x > 0) {
            ans += std::invoke(fn, this, x);
            x /= 2;
        }
        return ans;
    }

    Cap Ford(Cap at_least, Graph& gr) {
        Cap ans = 0;
        used.Assign(Vertices());
        while (Cap x = FordDFS(S, at_least, kMax, gr)) {
            used.Reset();
            ans += x;
        }
        return ans;
    }

    Cap FordDFS(Vertex v, Cap at_least, Cap prefix, Graph& gr) {
        if (v == T) {
            return prefix;
        }
        used.Use(v);
        while (gr.HasEdges(v)) {
            auto i = gr.Last(v);
            if (!used[To(i)] && CanPush(i) >= at_least) {
                Cap flow = FordDFS(To(i), at_least, std::min(prefix, CanPush(i)), gr);
                if (flow > 0) {
                    AddFlow(i, flow);
                    return flow;
                }
            }
            gr.Pop(v);
        }
        return 0;
    }

    Graph DinicBFS(Cap at_least, bool& fail) {
        Graph new_g(Vertices());
        used.Assign(Vertices());
        used.Set(S, 1);
        std::deque<Vertex> q = {S};
        while (!q.empty()) {
            Vertex v = q.front();
            q.pop_front();
            for (auto i : Edges(v)) {
                if (CanPush(i) < at_least) {
                    continue;
                }
                if (!used[To(i)]) {
                    used.Set(To(i), used.Get(v) + 1);
                    q.push_back(To(i));
                }
                if (used.Get(To(i)) == used.Get(v) + 1) {
                    new_g.Add(v, i);
                }
            }
        }
        if (used.Get(T) == 0) {
            fail = true;
        }
        return new_g;
    }

    static Edge Backward(Edge edge) {
        return Edge{edge.e ^ 1};
    }

private:
    std::vector<std::vector<Edge>> g;
    std::vector<EdgeData> edges;
    FlowUsedCounter used;
};

void solve() {
    int n, m;
    cin >> n >> m;
    Flow f;
    vector<Flow::Vertex> in(n), out(n);
    in[0] = f.AddVertex();
    out[0] = f.S;
    in[n - 1] = f.T;
    out[n - 1] = f.AddVertex();
    for (int i = 1; i < n - 1; ++i) {
        in[i] = f.AddVertex();
        out[i] = f.AddVertex();
    }
    for (int i = 0; i < m; ++i) {
        int a, b;
        cin >> a >> b;
        --a; --b;
        f.AddEdge(out[a], in[b], kMax);
        f.AddEdge(out[b], in[a], kMax);
    }
    vector<Flow::Edge> edges(n);
    for (int i = 0; i < n; ++i) {
        Cap c;
        cin >> c;
        edges[i] = f.AddEdge(in[i], out[i], c);
    }
    Cap cost = f.ScalableDinic();
    auto cut = f.Cut();
    ranges::sort(cut);
    vector<int> ans;
    for (int i = 1; i < n - 1; ++i) {
        auto it = ranges::lower_bound(cut, edges[i]);
        if (it != cut.end() && *it == edges[i]) {
            ans.push_back(i + 1);
        }
    }
    cout << cost << endl << ans.size() << endl << ans;
}

int32_t main() {
#ifdef LOCAL
    freopen("../in.txt", "r", stdin);
    freopen("../out.txt", "w", stdout);
    const auto start = clock();
#else
    cin.tie(0)->sync_with_stdio(false);
#endif
    int ttt = 1;
    // cin >> ttt;
    while (ttt-- > 0) solve();
#ifdef LOCAL
    cerr << setprecision(3) << fixed << endl
         << "TIME: " << static_cast<double>(clock() - start) / CLOCKS_PER_SEC << " sec" << endl;
#endif
}